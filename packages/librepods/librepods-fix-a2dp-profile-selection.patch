+void TestProfileChoice::acceptsPlaybackProfilesWithASource()
+{
+    // Fedora 44 with WirePlumber's Bluetooth input loopback exposes a source even in A2DP.
+    QVector<ProfileCandidate> profiles = {
+        {"off", "Off", 0, true, 0, 0},
+        {"a2dp-sink-sbc", "High Fidelity Playback (A2DP Sink, codec SBC)", 133, true, 1, 1},
+        {"a2dp-sink-sbc_xq", "High Fidelity Playback (A2DP Sink, codec SBC-XQ)", 132, true, 1, 1},
+        {"a2dp-sink", "High Fidelity Playback (A2DP Sink, codec AAC)", 134, true, 1, 1},
+        {"headset-head-unit-cvsd", "Headset Head Unit (HSP/HFP, codec CVSD)", 5, true, 1, 1},
+        {"headset-head-unit-msbc", "Headset Head Unit (HSP/HFP, codec MSBC)", 6, true, 1, 1},
+        {"headset-head-unit", "Headset Head Unit (HSP/HFP, codec LC3-24kHz)", 7, true, 1, 1},
+    };
+    QCOMPARE(bestPlaybackProfile(profiles), QString("a2dp-sink-sbc_xq"));
+    for (ProfileCandidate &profile : profiles) {
+        if (profile.name == "a2dp-sink-sbc_xq") profile.available = false;
+    }
+    QCOMPARE(bestPlaybackProfile(profiles), QString("a2dp-sink-sbc"));
+    for (ProfileCandidate &profile : profiles) {
+        if (profile.name == "a2dp-sink-sbc") profile.available = false;
+    }
+    QCOMPARE(bestPlaybackProfile(profiles), QString("a2dp-sink"));
+}
